{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solaris-weather-proxy",
  "main": "index.mjs",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "WEATHER_ENABLED": "true",
    "ALLOWED_ORIGINS": "http://localhost:8080,http://127.0.0.1:8080,https://progritit.github.io",
  },
  "ratelimits": [
    {
      "name": "CLIENT_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "UPSTREAM_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
